/* Windows resource script: the application icon.
 *
 * The path is relative to this file (assets/app.rc -> assets/icon.ico).
 */
1 ICON "icon.ico"

1 VERSIONINFO
 FILEVERSION 2,1,5,0
 PRODUCTVERSION 2,1,5,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "SNI Tunnel V2\0"
   VALUE "FileVersion", "2.1.5.0\0"
   VALUE "ProductName", "SNI Tunnel\0"
   VALUE "ProductVersion", "2.1.5\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
